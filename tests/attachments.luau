local function near(a,b) assert((a-b).Magnitude<1e-7,tostring(a)..' ~= '..tostring(b)) end
local function frame(a,b)
    near(a.Position,b.Position);near(a.RightVector,b.RightVector);near(a.UpVector,b.UpVector);near(a.LookVector,b.LookVector)
end
local function rejects(fn) assert(not pcall(fn),'Expected an error') end
local part=Instance.new('Part',workspace)
part.CFrame=CFrame.new(10,20,30)*CFrame.Angles(0.2,0.4,-0.3)
local folder=Instance.new('Folder',part)
local a=Instance.new('Attachment',folder)
assert(a.CFrame==CFrame.identity and not a.Visible and a.Axis==Vector3.xAxis and a.SecondaryAxis==Vector3.yAxis)
a.Position=Vector3.new(2,3,4);frame(a.WorldCFrame,part.CFrame*a.CFrame)
a.Orientation=Vector3.new(20,30,40);near(a.Orientation,Vector3.new(20,30,40))
a.Rotation=Vector3.new(10,25,40);near(a.Rotation,Vector3.new(10,25,40))
a:SetAxis(Vector3.new(0,0,8));near(a:GetAxis(),Vector3.zAxis)
assert(math.abs(a.Axis:Dot(a.SecondaryAxis))<1e-8)
local old=a.CFrame;a.Axis=Vector3.zero;assert(a.CFrame==old)
a.SecondaryAxis=a.Axis;assert(a.CFrame==old)
a.SecondaryAxis=Vector3.new(0,8,1);near(a.SecondaryAxis,Vector3.yAxis)
a.CFrame=CFrame.identity;a.Axis=Vector3.yAxis
near(a.SecondaryAxis,-Vector3.xAxis)
local child=Instance.new('Attachment',a)
child.CFrame=CFrame.new(3,1,2)*CFrame.Angles(0.1,0.2,0.3)
frame(child.WorldCFrame,part.CFrame*a.CFrame*child.CFrame)
local wanted=CFrame.new(-5,7,9)*CFrame.Angles(-0.4,0.3,0.2)
child.WorldCFrame=wanted;frame(child.WorldCFrame,wanted)
child.WorldPosition=Vector3.new(1,2,3);near(child.WorldPosition,Vector3.new(1,2,3))
child.WorldAxis=Vector3.xAxis;near(child.WorldAxis,Vector3.xAxis)
child.WorldSecondaryAxis=Vector3.yAxis;near(child.WorldSecondaryAxis,Vector3.yAxis)
child.WorldOrientation=Vector3.new(10,20,30);near(child.WorldOrientation,Vector3.new(10,20,30))
local copied=part:Clone()
frame(copied.Folder.Attachment.Attachment.WorldCFrame,child.WorldCFrame)
part.Position+=Vector3.new(1,2,3)
near(child.WorldPosition,copied.Folder.Attachment.Attachment.WorldPosition+Vector3.new(1,2,3))
child.Parent=nil;frame(child.WorldCFrame,child.CFrame)
local model=Instance.new('Model',workspace);model.WorldPivot=CFrame.new(30,40,50)
child.Parent=model;frame(child.WorldCFrame,model:GetPivot()*child.CFrame)
local bone=Instance.new('Bone',part)
bone.CFrame=CFrame.new(1,2,3);bone.Transform=CFrame.new(0,5,0)*CFrame.Angles(0,0,0.4)
frame(bone.WorldCFrame,part.CFrame*bone.CFrame)
frame(bone.TransformedCFrame,bone.CFrame*bone.Transform)
frame(bone.TransformedWorldCFrame,part.CFrame*bone.CFrame*bone.Transform)
local nested=Instance.new('Bone',bone);nested.CFrame=CFrame.new(0,2,0);nested.Transform=CFrame.Angles(0.2,0,0)
frame(nested.WorldCFrame,bone.TransformedWorldCFrame*nested.CFrame)
frame(nested.TransformedWorldCFrame,bone.TransformedWorldCFrame*nested.CFrame*nested.Transform)
child.Parent=nested
frame(child.WorldCFrame,nested.TransformedWorldCFrame*child.CFrame)
local changes=0;a:GetPropertyChangedSignal('CFrame'):Connect(function() changes+=1 end)
a.Position+=Vector3.one;assert(changes==1)
a.Position=a.Position;assert(changes==1)
local rope=Instance.new('RopeConstraint',part);rope.Attachment0=a;rope.Attachment1=child
assert(table.find(a:GetConstraints(),rope) and table.find(child:GetConstraints(),rope))
local snapshot=a:GetConstraints();rope.Attachment0=nil
assert(#a:GetConstraints()==0 and table.find(snapshot,rope))
rejects(function() rope.Attachment1=part end)
rope:Destroy();assert(#child:GetConstraints()==0)
rejects(function() a.Position={} end);rejects(function() a.WorldAxis=Vector3.new(0/0,0,0) end)
rejects(function() bone.TransformedCFrame=CFrame.identity end)
rejects(function() a.WorldRotation=Vector3.zero end)
local rng=Random.new(735735)
for i=1,300 do
    local target=Vector3.new(rng:NextNumber(-1,1),rng:NextNumber(-1,1),rng:NextNumber(-1,1)).Unit
    a.Axis=target;near(a.Axis,target);assert(math.abs(a.Axis:Dot(a.SecondaryAxis))<1e-7)
    near(a.Axis:Cross(a.SecondaryAxis),a.CFrame.ZVector)
    a.WorldPosition=target*20;near(a.WorldPosition,target*20)
end
local tween=game:GetService('TweenService'):Create(bone,TweenInfo.new(0.05),{Transform=CFrame.new(0,10,0)})
tween:Play();tween.Completed:Wait()
frame(bone.TransformedWorldCFrame,part.CFrame*bone.CFrame*CFrame.new(0,10,0))
part:Destroy();copied:Destroy();model:Destroy()
print('ATTACHMENT AND BONE HIERARCHY, AXES, WORLD WRITES, CONSTRAINT LINKS AND TWEENS PASSED',300)
