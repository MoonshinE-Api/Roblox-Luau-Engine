local function rejects(fn)
    local ok=pcall(fn)
    assert(not ok,"Expected invalid input to fail")
end
local a=NumberSequenceKeypoint.new(0,4)
assert(typeof(a)=="NumberSequenceKeypoint" and a.Envelope==0)
assert(a==NumberSequenceKeypoint.new(0,4,0))
rejects(function() a.Time=0.5 end)
rejects(function() NumberSequenceKeypoint.new(-1,3) end)
rejects(function() NumberSequenceKeypoint.new(0,3,-1) end)
local source={a,NumberSequenceKeypoint.new(0.5,8,2),NumberSequenceKeypoint.new(1,4)}
local sequence=NumberSequence.new(source)
source[2]=nil
assert(#sequence.Keypoints==3 and sequence.Keypoints[2].Envelope==2)
local returned=sequence.Keypoints
returned[2]=nil
assert(#sequence.Keypoints==3)
assert(NumberSequence.new(4)==NumberSequence.new(4,4))
assert(NumberSequence.new(4)~=sequence)
assert(NumberSequence.new{a,NumberSequenceKeypoint.new(0,7),NumberSequenceKeypoint.new(1,4)}.Keypoints[2].Time==0)
rejects(function() NumberSequence.new{a} end)
rejects(function() NumberSequence.new{NumberSequenceKeypoint.new(0.1,3),NumberSequenceKeypoint.new(1,4)} end)
rejects(function() NumberSequence.new{a,NumberSequenceKeypoint.new(0.8,3),NumberSequenceKeypoint.new(0.2,3),NumberSequenceKeypoint.new(1,4)} end)
local tooMany={};for i=0,20 do tooMany[i+1]=NumberSequenceKeypoint.new(i/20,i) end
rejects(function() NumberSequence.new(tooMany) end)
local red,blue=Color3.new(1,0,0),Color3.new(0,0,1)
local colors=ColorSequence.new(red,blue)
assert(typeof(colors)=="ColorSequence" and colors.Keypoints[2].Value==blue)
assert(colors==ColorSequence.new{ColorSequenceKeypoint.new(0,red),ColorSequenceKeypoint.new(1,blue)})
assert(ColorSequence.new(red)==ColorSequence.new(red,red))
rejects(function() ColorSequence.new{a,NumberSequenceKeypoint.new(1,4)} end)
local faces=Faces.new(Enum.NormalId.Top,Enum.NormalId.Front)
assert(typeof(faces)=="Faces" and faces.Top and faces.Front and not faces.Bottom)
assert(faces==Faces.new(Enum.NormalId.Front,Enum.NormalId.Top))
local axes=Axes.new(Enum.NormalId.Left,Enum.Axis.Z)
assert(typeof(axes)=="Axes" and axes.X and axes.Z and not axes.Y)
assert(axes.Left and axes.Right and axes.Front and axes.Back and not axes.Top)
assert(not Axes.new().X and not Faces.new().Top)
rejects(function() Faces.new(Enum.Axis.X) end)
rejects(function() Axes.new(Enum.Material.Plastic) end)
local waypoint=PathWaypoint.new(Vector3.new(2,3,4),Enum.PathWaypointAction.Jump,"Ledge")
assert(typeof(waypoint)=="PathWaypoint" and waypoint.Label=="Ledge" and waypoint.Position.Y==3)
assert(PathWaypoint.new(Vector3.zero,Enum.PathWaypointAction.Walk).Label=="")
local folder=Instance.new("Folder")
folder:SetAttribute("Gradient",colors)
folder:SetAttribute("Curve",sequence)
assert(folder:Clone():GetAttribute("Gradient")==colors)
print("DOCUMENTED TYPE CONTRACT CHECKS PASSED")
