local function near(a,b,e) assert(math.abs(a-b)<(e or 1e-8),tostring(a)..' ~= '..tostring(b)) end
local function vec(a,b) assert((a-b).Magnitude<1e-8,tostring(a)..' ~= '..tostring(b)) end
local function rejects(fn) assert(not pcall(fn),'Expected failure') end
for _,V in {Vector2,Vector3} do
    assert(V.new('2',false,{}).X==2 and V.new('2',false,{}).Y==0)
    local v=V.new(-1.5,2.2,-3.7)
    assert(v:Abs()==V.new(1.5,2.2,3.7))
    assert(v:Floor()==V.new(-2,2,-4) and v:Ceil()==V.new(-1,3,-3))
    assert(v:Sign()==V.new(-1,1,-1))
    assert(v:Min()==v and v:Max()==v)
    assert(v:Min(V.new(-10,10,10),V.new(3,0,4))==V.new(-10,0,-3.7))
    assert(v:Max(V.new(-10,10,10),V.new(3,0,4))==V.new(3,10,10))
    assert(V.new(1000000,2,3):FuzzyEq(V.new(1000001,2,3)))
    assert(not V.new(0,1e9,0):FuzzyEq(V.new(1,1e9,0)))
    assert(V.new():FuzzyEq(V.new(0.000008,0.000008,0.000008)))
    assert(V.new():FuzzyEq(V.new(0.000008,0.000008,0.000008),-0.00001))
    rejects(function() v:Min({}) end)
end
near(Vector2.xAxis:Angle(Vector2.yAxis),math.pi/2)
near(Vector2.yAxis:Angle(Vector2.xAxis,true),-math.pi/2)
assert(Vector2.new(2,3):Cross(Vector2.new(4,5))==-2)
near(Vector3.xAxis:Angle(Vector3.yAxis),math.pi/2)
near(Vector3.yAxis:Angle(Vector3.xAxis,Vector3.zAxis),-math.pi/2)
assert(Vector3.zero:Angle(Vector3.one)==0 and Vector2.zero:Angle(Vector2.one)==0)
rejects(function() Vector2.one:FuzzyEq(Vector2.zero,0.2) end)
assert(Vector3.zero:FuzzyEq(Vector3.one,2))
local nan=0/0
assert(Vector3.new(nan,0,0):FuzzyEq(Vector3.zero))
assert(Vector2.new(nan,0):FuzzyEq(Vector2.zero))
assert(not Vector2.new(0,nan):FuzzyEq(Vector2.zero))
assert(Color3.fromHex('#fA0')==Color3.fromRGB(255,170,0))
assert(Color3.fromHex('ffAA00\0ignored')==Color3.fromRGB(255,170,0))
assert(Color3.fromHex(123)==Color3.fromHex('123'))
assert(Color3.new('0.5',false,{}).R==0.5 and Color3.fromRGB()==Color3.new() and Color3.fromHSV()==Color3.new())
for _,value in {'','#','12','1234','ggg','0xff00','##fff'} do rejects(function() Color3.fromHex(value) end) end
local h,s,v=Color3.new(-1,2,3):ToHSV();near(h,0.5);near(s,1);near(v,1)
local _,rawS,rawV=Color3.toHSV(Color3.new(-1,2,3));near(rawS,4/3);near(rawV,3)
local random=Random.new(740)
for i=1,400 do
    local r,g,b=random:NextNumber(),random:NextNumber(),random:NextNumber()
    local color=Color3.new(r,g,b)
    local hue,saturation,value=color:ToHSV()
    local rebuilt=Color3.fromHSV(hue,saturation,value)
    near(rebuilt.R,r);near(rebuilt.G,g);near(rebuilt.B,b)
    local alpha,beta=random:NextNumber(-10,10),random:NextNumber(-10,10)
    local a=Vector2.new(math.cos(alpha),math.sin(alpha));local other=Vector2.new(math.cos(beta),math.sin(beta))
    local angle=a:Angle(other,true)
    near(math.cos(angle),a:Dot(other));near(math.sin(angle),a:Cross(other))
end
local cf=CFrame.new(2,3,4)*CFrame.Angles(0.2,-0.7,0.4)
assert(cf:ToWorldSpace()==cf and cf:ToObjectSpace()==cf:Inverse())
vec(cf:PointToWorldSpace(),cf.Position)
vec(cf:PointToObjectSpace(),cf:Inverse().Position)
vec(cf:VectorToWorldSpace(),Vector3.zero)
local a,b=Vector3.new(1,2,3),Vector3.new(-3,4,7)
local points=table.pack(cf:PointToWorldSpace(a,b))
assert(points.n==2);vec(points[1],cf*a);vec(points[2],cf*b)
local back=table.pack(cf:PointToObjectSpace(points[1],points[2]))
vec(back[1],a);vec(back[2],b)
local directions=table.pack(cf:VectorToWorldSpace(a,b))
local inverse=table.pack(cf:VectorToObjectSpace(directions[1],directions[2]))
vec(inverse[1],a);vec(inverse[2],b)
local cframes=table.pack(cf:ToWorldSpace(CFrame.new(1,0,0),CFrame.new(0,1,0)))
assert(cframes.n==2)
local localFrames=table.pack(cf:ToObjectSpace(cframes[1],cframes[2]))
vec(localFrames[1].Position,Vector3.xAxis);vec(localFrames[2].Position,Vector3.yAxis)
rejects(function() cf:PointToWorldSpace(nil) end)
rejects(function() cf:ToWorldSpace(Vector3.zero) end)
