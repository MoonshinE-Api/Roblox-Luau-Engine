local players=game:GetService('Players')
local storage=game:GetService('ReplicatedStorage')
local run=game:GetService('RunService')
local player=players.LocalPlayer
local probe=storage:WaitForChild('RosterContextProbe')
local remote=probe:WaitForChild('Broadcast')
assert(player==players:GetPlayers()[1] and player.Character.Name=='OldCharacter')
local received,removed,added={},0,0
local charAdded=player.CharacterAdded:Connect(function(character)
    assert(run:IsClient() and character.Name=='NewCharacter' and player.Character==character)
    task.wait(.02);assert(run:IsClient());probe:SetAttribute('CharacterDone',true)
end)
local charRemoving=player.CharacterRemoving:Connect(function(character)
    assert(run:IsClient() and character.Name=='OldCharacter' and player.Character==character)
end)
players.PlayerRemoving:Connect(function(value,reason)
    assert(run:IsClient() and value==player and players.NumPlayers==0 and value.Parent==players)
    assert(reason==Enum.PlayerExitReason.Unknown);removed+=1
end)
players.PlayerAdded:Connect(function(value) assert(run:IsClient() and value==player and players.NumPlayers==1);added+=1 end)
remote.OnClientEvent:Connect(function(value)
    assert(run:IsClient());table.insert(received,value)
end)
probe:SetAttribute('ClientReady',true)
task.wait(.04)
assert(#received==2 and received[1]=='before' and received[2]=='after')
assert(removed==1 and added==1 and probe:GetAttribute('CharacterDone'))
charAdded:Disconnect();charRemoving:Disconnect()
probe:SetAttribute('ClientComplete',true)
print('PLAYER CLIENT SIGNAL CONTEXT AND BROADCAST MEMBERSHIP PASSED')
