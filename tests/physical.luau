local function close(a,b)assert(math.abs(a-b)<1e-5,tostring(a)..' vs '..tostring(b))end
local props=PhysicalProperties.new(2,.5,.25)
assert(typeof(props)=='PhysicalProperties' and props.FrictionWeight==1 and props.ElasticityWeight==1 and props.AcousticAbsorption==1)
assert(props==PhysicalProperties.new(2,.5,.25,1,1,1))
assert(not pcall(function()props.Density=4 end))
assert(not pcall(function()PhysicalProperties.new()end))
assert(not pcall(function()PhysicalProperties.new(Enum.PartType.Block)end))
assert(not pcall(function()PhysicalProperties.new(0/0,1,1)end))
assert(not pcall(function()PhysicalProperties.new('x',1,1)end))
local clamped=PhysicalProperties.new(-10,5,-1,-4,101,2)
assert(clamped.Density==__engine.physicalCatalog.minimum_density and clamped.Friction==2 and clamped.Elasticity==0)
assert(clamped.FrictionWeight==0 and clamped.ElasticityWeight==100 and clamped.AcousticAbsorption==1)
local part=Instance.new('Part',workspace);part.Size=Vector3.new(2,4,6)
assert(part.CustomPhysicalProperties==nil and part.CurrentPhysicalProperties==PhysicalProperties.new(Enum.Material.Plastic))
local plastic=part:GetMass();part.Material=Enum.Material.Metal
assert(part:GetMass()>plastic*10 and part.Mass==part:GetMass() and part:getMass()==part.Mass)
part.CustomPhysicalProperties=props;assert(part.CurrentPhysicalProperties==props and part:GetMass()==96)
part.Massless=true;assert(part:GetMass()==96 and part.AssemblyMass==96)
part.Anchored=true;assert(part:GetMass()==96 and part.AssemblyMass==math.huge)
part.Anchored=false
part.Shape=Enum.PartType.Ball;close(part:GetMass(),(4/3)*math.pi*2)
part.Shape=Enum.PartType.Cylinder;close(part:GetMass(),2*math.pi*2*2*2)
assert(part.CenterOfMass==Vector3.zero and part.AssemblyCenterOfMass==part.Position)
part.Size=Vector3.zero;assert(part:GetMass()>0)
local clone=part:Clone();assert(clone.CustomPhysicalProperties==props);clone:Destroy()
local material=game:GetService('MaterialService')
local folder=Instance.new('Folder',material)
local base=Instance.new('MaterialVariant',folder);base.Name='DenseMetal';base.BaseMaterial=Enum.Material.Metal
base.CustomPhysicalProperties=PhysicalProperties.new(8,1,0)
local special=Instance.new('MaterialVariant',material);special.Name='SpecialMetal';special.BaseMaterial=Enum.Material.Metal
special.CustomPhysicalProperties=PhysicalProperties.new(3,1,0)
assert(material:GetMaterialVariant(Enum.Material.Metal,'DenseMetal')==base)
assert(material:GetMaterialVariant(Enum.Material.Wood,'DenseMetal')==nil)
assert(material:GetBaseMaterialOverride(Enum.Material.Metal)=='')
material:SetBaseMaterialOverride(Enum.Material.Metal,'DenseMetal')
part.CustomPhysicalProperties=nil;part.Shape=Enum.PartType.Block;part.Size=Vector3.new(2,4,6)
assert(part.CurrentPhysicalProperties==base.CustomPhysicalProperties and part.Mass==384)
part.MaterialVariant='SpecialMetal';assert(part.Mass==144)
special.CustomPhysicalProperties=nil;assert(part.Mass==384)
part.CustomPhysicalProperties=props;assert(part.Mass==96)
assert(PhysicalProperties.new(Enum.Material.Metal).Density~=8,'Enum constructor incorrectly inherited world override')
part.CustomPhysicalProperties=nil;part.MaterialVariant='missing';assert(part.Mass==384)
material:SetBaseMaterialOverride(Enum.Material.Metal,'');assert(part.CurrentPhysicalProperties==PhysicalProperties.new(Enum.Material.Metal))
assert(not pcall(function()material:GetMaterialVariant('Metal','x')end))
for _,class in {'WedgePart','CornerWedgePart'} do
    local wedge=Instance.new(class,workspace);assert(wedge:IsA('BasePart'))
    wedge.Size=Vector3.new(2,4,6);wedge.CustomPhysicalProperties=props
    close(wedge:GetMass(),class=='WedgePart' and 48 or 32)
    assert(wedge.CenterOfMass~=Vector3.zero)
    wedge.CFrame=CFrame.new(4,5,6)*CFrame.Angles(0,math.pi/2,0)
    assert((wedge.AssemblyCenterOfMass-wedge.CFrame:PointToWorldSpace(wedge.CenterOfMass)).Magnitude<1e-6)
    wedge:Destroy()
end
base:Destroy();special:Destroy();folder:Destroy();part:Destroy()
print('PHYSICAL PROPERTIES/MATERIALS/MASS CHECKS PASSED')
