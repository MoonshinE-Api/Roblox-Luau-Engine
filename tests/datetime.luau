local function rejects(fn) assert(not pcall(fn),"Expected DateTime error") end
local epoch=DateTime.fromUnixTimestamp()
assert(typeof(epoch)=="DateTime" and tostring(epoch)=="0")
assert(epoch.UnixTimestamp==0 and epoch.UnixTimestampMillis==0)
assert(epoch==DateTime.fromUniversalTime() and epoch==DateTime.fromUnixTimestampMillis())
assert(epoch:ToIsoDate()=="1970-01-01T00:00:00Z")
assert(DateTime.fromUnixTimestamp(-0.9)==epoch)
local negative=DateTime.fromUnixTimestampMillis(-1)
local t=negative:ToUniversalTime()
assert(t.Year==1969 and t.Month==12 and t.Day==31 and t.Hour==23 and t.Minute==59 and t.Second==59 and t.Millisecond==999)
assert(negative.UnixTimestamp==0 and negative.UnixTimestampMillis== -1)
assert(tostring(negative)=="-1" and negative:ToIsoDate()=="1969-12-31T23:59:59.999000Z")
local leap=DateTime.fromUniversalTime(2024,2,29,23,59,59,999)
assert(leap.UnixTimestampMillis==1709251199999)
assert(DateTime.fromIsoDate(leap:ToIsoDate())==leap)
assert(DateTime.fromUniversalTime(2000,2,29):ToUniversalTime().Day==29)
rejects(function() DateTime.fromUniversalTime(1900,2,29) end)
rejects(function() DateTime.fromUniversalTime(2100,2,29) end)
assert(DateTime.fromUniversalTime(2024,1,1,24)==DateTime.fromUniversalTime(2024,1,2))
assert(DateTime.fromUniversalTime(2024,1,1,0,0,-10)==DateTime.fromUniversalTime(2023,12,31,23,59,50))
-- Supplied Boost duration applies a negative sign to every unit if one is negative.
assert(DateTime.fromUniversalTime(2024,1,1,1,0,-10)==DateTime.fromUniversalTime(2023,12,31,22,59,50))
assert(DateTime.fromUniversalTime(2024,1,1,0,0,0,1000)==DateTime.fromUniversalTime(2024,1,1,0,0,1))
assert(DateTime.fromUniversalTime("2024",1.9,1.9)==DateTime.fromUniversalTime(2024,1,1))
for _,date in {DateTime.fromUnixTimestampMillis(-17987443200000),DateTime.fromUnixTimestampMillis(253402300799999)} do
    assert(DateTime.fromIsoDate(date:ToIsoDate())==date)
end
rejects(function() DateTime.fromUnixTimestampMillis(-17987443200001) end)
rejects(function() DateTime.fromUnixTimestampMillis(253402300800000) end)
rejects(function() DateTime.fromUnixTimestamp(math.huge) end)
rejects(function() DateTime.fromUnixTimestamp(0/0) end)
rejects(function() DateTime.fromUnixTimestamp(nil) end)
rejects(function() DateTime.fromUniversalTime(2024,nil) end)
rejects(function() DateTime.fromUniversalTime(2024,13,1) end)
rejects(function() DateTime.fromUniversalTime(2024,4,31) end)
rejects(function() epoch.UnixTimestamp=1 end)
rejects(function() DateTime.fromIsoDate("bad date") end)
local precise=DateTime.fromIsoDate("1969-12-31T23:59:59.999999Z")
assert(precise.UnixTimestamp==0 and precise.UnixTimestampMillis==0)
assert(precise~=epoch and tostring(precise)=="0")
assert(precise:ToIsoDate()=="1969-12-31T23:59:59.999999Z")
assert(DateTime.fromIsoDate("2020-01-02T13:30:45+03:00")==DateTime.fromIsoDate("2020-01-02T10:30:45Z"))
local stamp=DateTime.fromUniversalTime(2024,2,29,13,4,5,678)
assert(stamp:FormatUniversalTime("YYYY YY MMMM MMM MM M DD D DDDD DDD dddd ddd dd d HH H hh h mm m ss s SSS SS S A a","en-us")==
    "2024 24 February Feb 02 2 29 29 060 60 Thursday Thu Th 4 13 13 01 1 04 4 05 5 678 67 6 PM pm")
assert(stamp:FormatUniversalTime("LLLL","en-us")=="Thursday, February 29, 2024 1:04 PM")
assert(stamp:FormatUniversalTime("[YYYY] YYYY [literal] [unfinished","en-us")=="YYYY 2024 literal unfinished")
assert(stamp:FormatUniversalTime("L","en-gb")=="29/02/2024")
assert(stamp:FormatUniversalTime("MMMM dddd","ru-ru")=="февраль четверг")
assert(stamp:FormatUniversalTime("LLLL","zh-cn")=="2024年2月29日星期四下午1点04分")
assert(stamp:FormatUniversalTime("YYYY","unsupported-locale")=="2024")
assert(stamp:FormatUniversalTime(123,"en-us")=="123")
assert(stamp:FormatUniversalTime("YYYY\0MM","en-us")=="2024")
local localFields=stamp:ToLocalTime()
local localCopy=DateTime.fromLocalTime(localFields.Year,localFields.Month,localFields.Day,localFields.Hour,localFields.Minute,localFields.Second,localFields.Millisecond)
assert(localCopy==stamp)
local copied=stamp:ToUniversalTime();copied.Year=1;assert(stamp:ToUniversalTime().Year==2024)
local now=DateTime.now();assert(math.abs(now.UnixTimestamp-os.time())<=2)
print("PASS DateTime: UTC/local, microseconds, leap years, normalization, bounds, ISO and localized formats")
