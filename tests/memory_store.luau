local function rejects(fn) assert(not pcall(fn),'Expected failure') end
local service=game:GetService('MemoryStoreService')
if game:GetService('RunService'):IsClient() then
    rejects(function() service:GetHashMap('Private') end)
    rejects(function() service:GetQueue('Private') end)
    print('CLIENT MEMORY STORE ACCESS REJECTED');return
end
local hash=service:GetHashMap('Transient')
assert(hash==service:GetHashMap('Transient'))
assert(hash:SetAsync('false',false,10) and hash:GetAsync('false')==false)
hash:UpdateAsync('false',function(old) assert(old==false);return true end,10)
assert(hash:GetAsync('false')==true)
hash:SetAsync('object',{n=1},10)
local copy=hash:GetAsync('object');copy.n=999
assert(hash:GetAsync('object').n==1)
assert(hash:UpdateAsync('object',function() return nil end,10)==nil)
assert(hash:GetAsync('object').n==1)
rejects(function() hash:UpdateAsync('object',function() task.wait();return 2 end,10) end)
local calls=0
hash:SetAsync('counter',0,10)
local value=hash:UpdateAsync('counter',function(n)
    calls+=1;if calls==1 then hash:SetAsync('counter',10,10) end
    return n+1
end,10)
assert(value==11 and calls==2)
local page=hash:ListItemsAsync(2);local total=0
repeat
    total+=#page:GetCurrentPage()
    if page.IsFinished then break end
    page:AdvanceToNextPageAsync()
until false
assert(total==3)
rejects(function() page:AdvanceToNextPageAsync() end)
hash:SetAsync('expired',1,0);assert(hash:GetAsync('expired')==nil)
hash:SetAsync('ttl',1,1)
local sorted=service:GetSortedMap('Matchmaking')
sorted:SetAsync('a',{player=1},10,10);sorted:SetAsync('b',{player=2},10,20);sorted:SetAsync('c',{player=3},10,30)
local record,key=sorted:GetAsync('b');assert(record.player==2 and key==20)
local range=sorted:GetRangeAsync(Enum.SortDirection.Descending,2)
assert(#range==2 and range[1].key=='c' and range[2].sortKey==20)
range=sorted:GetRangeAsync(Enum.SortDirection.Ascending,200,{sortKey=10},{sortKey=30})
assert(#range==1 and range[1].key=='b')
local update,ordering=sorted:UpdateAsync('b',function(old,order) old.player=22;return old,order+5 end,10)
assert(update.player==22 and ordering==25 and sorted:GetSizeAsync()==3)
sorted:RemoveAsync('a');assert(sorted:GetSizeAsync()==2)
rejects(function() sorted:SetAsync('bad',1,10,false) end)
rejects(function() hash:SetAsync('bad','x',3888001) end)
rejects(function() hash:SetAsync('bad',string.rep('x',32769),10) end)
rejects(function() sorted:GetRangeAsync(Enum.SortDirection.Ascending,201) end)
local queue=service:GetQueue('Work',1)
queue:AddAsync('a',10,1);queue:AddAsync('b',10,5);queue:AddAsync('c',10,5)
local items,id=queue:ReadAsync(2,true,0)
assert(items[1]=='b' and items[2]=='c' and type(id)=='string')
assert(queue:GetSizeAsync()==3 and queue:GetSizeAsync(true)==1)
local empty,nothing=queue:ReadAsync(2,true,0);assert(#empty==0 and nothing==nil and queue:GetSizeAsync(true)==1)
queue:RemoveAsync(id);assert(queue:GetSizeAsync()==1)
local one,lease=queue:ReadAsync(1,false,0);assert(one[1]=='a' and queue:GetSizeAsync(true)==0)
task.wait(1.1)
assert(hash:GetAsync('ttl')==nil and queue:GetSizeAsync(true)==1)
queue:RemoveAsync(lease);assert(queue:GetSizeAsync()==1,'Expired lease must not delete the item')
local again,newLease=queue:ReadAsync(1,false,0);assert(again[1]=='a')
queue:RemoveAsync(newLease);assert(queue:GetSizeAsync()==0)
task.delay(0.05,function() queue:AddAsync('late',10) end)
local start=time();local late,lateId=queue:ReadAsync(1,false,0.2)
assert(late[1]=='late' and time()-start>=0.19)
queue:RemoveAsync(lateId)
queue:AddAsync(false,10)
local falseItems,falseId=queue:ReadAsync(1,false,0);assert(falseItems[1]==false)
queue:RemoveAsync(falseId)
assert(queue:GetSizeAsync()==0)
rejects(function() service:GetQueue('Bad',false) end)
rejects(function() queue:AddAsync(1,10,false) end)
rejects(function() queue:ReadAsync(101) end)
print('MEMORY MAP, SORTED RANGE, TTL, QUEUE PRIORITY, LEASE AND WAIT CHECKS PASSED')
