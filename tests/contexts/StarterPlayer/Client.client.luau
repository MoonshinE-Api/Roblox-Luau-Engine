local run=game:GetService("RunService")
local storage=game:GetService("ReplicatedStorage")
local side=require(storage.Side)
assert(side.side=="client")
local remote=storage:WaitForChild("BothDirections")
remote.OnClientInvoke=function(value)
    assert(run:IsClient() and require(storage.Side)==side)
    task.wait(0.02)
    assert(run:IsClient() and require(storage.Side)==side)
    return "client",value,nil,5
end
local result=table.pack(remote:InvokeServer(6))
assert(result.n==4 and result[1]=="server" and result[2]==6 and result[3]==nil and result[4]==4)
assert(run:IsClient() and require(storage.Side)==side)
local ok,message=pcall(function() remote:InvokeServer("fail") end)
assert(not ok and string.find(message,"intentional server error",1,true))
assert(run:IsClient() and require(storage.Side)==side)
remote:SetAttribute("ClientReady",true)
print("CLIENT CALLBACK CONTEXT PASSED")
