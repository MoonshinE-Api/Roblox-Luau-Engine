local function close(a,b) assert((a-b).Magnitude<1e-6,tostring(a)..' vs '..tostring(b)) end
local model=Instance.new('Model',workspace)
local cf,size=model:GetBoundingBox();assert(cf==CFrame.new() and size==Vector3.zero)
local part=Instance.new('Part',model);part.Anchored=true;part.Size=Vector3.new(2,4,6);part.Position=Vector3.new(10,0,0)
assert(model:GetPivot().Position==Vector3.new(10,0,0))
part.Position=Vector3.new(20,0,0);assert(model.WorldPivot.Position==Vector3.new(20,0,0))
model.WorldPivot=CFrame.new(5,0,0);part.Position=Vector3.new(30,0,0)
assert(model:GetPivot().Position==Vector3.new(5,0,0))
local cloned=model:Clone();assert(cloned.WorldPivot==model.WorldPivot)
model:PivotTo(CFrame.new(10,0,0));assert(model:GetPivot().Position==Vector3.new(10,0,0) and part.Position==Vector3.new(35,0,0))
assert(not pcall(function()model.PrimaryPart=Instance.new('Folder')end))
local outsider=Instance.new('Part',workspace);model.PrimaryPart=outsider;assert(model.PrimaryPart==outsider)
task.wait();assert(model.PrimaryPart==nil)
model.PrimaryPart=part;part.PivotOffset=CFrame.new(0,1,0);assert(model:GetPivot()==part:GetPivot())
part.CFrame=CFrame.new(0,0,0)*CFrame.Angles(0,0,math.pi/2)
cf,size=model:GetBoundingBox();close(cf.Position,Vector3.zero);close(size,part.Size)
assert(cf.Rotation==part.CFrame.Rotation)
model.PrimaryPart=nil;cf,size=model:GetBoundingBox();close(size,Vector3.new(4,2,6));assert(cf.Rotation==CFrame.new())
model.PrimaryPart=part;part.Parent=workspace;task.wait();assert(model.PrimaryPart==nil)
model:Destroy();outsider:Destroy();part:Destroy();cloned:Destroy()
print('MODEL BOUNDS/PIVOT/PRIMARY PART CHECKS PASSED')
